{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.anirecord.com.ar"
        }
      ],
      "destination": "https://anirecord.com.ar/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "anime-list-alca.vercel.app"
        }
      ],
      "destination": "https://anirecord.com.ar/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "anime-list-matias.vercel.app"
        }
      ],
      "destination": "https://anirecord.com.ar/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "anirecord.vercel.app"
        }
      ],
      "destination": "https://anirecord.com.ar/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/media/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|discordbot|Twitterbot|facebookexternalhit|Facebot|WhatsApp|TelegramBot|Slackbot|LinkedInBot).*"
        }
      ],
      "destination": "/api/media-preview?id=:id"
    },
    {
      "source": "/personajes/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|discordbot|Twitterbot|facebookexternalhit|Facebot|WhatsApp|TelegramBot|Slackbot|LinkedInBot).*"
        }
      ],
      "destination": "/api/person-preview?id=:id&kind=character"
    },
    {
      "source": "/seiyuus/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|discordbot|Twitterbot|facebookexternalhit|Facebot|WhatsApp|TelegramBot|Slackbot|LinkedInBot).*"
        }
      ],
      "destination": "/api/person-preview?id=:id&kind=staff"
    },
    {
      "source": "/profesionales/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|discordbot|Twitterbot|facebookexternalhit|Facebot|WhatsApp|TelegramBot|Slackbot|LinkedInBot).*"
        }
      ],
      "destination": "/api/person-preview?id=:id&kind=professional"
    },
    {
      "source": "/api/:path*",
      "destination": "https://p01--anime-list--244mm2wyvsvc.code.run/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
