{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.anirecord.com.ar"
        }
      ],
      "destination": "https://anirecord.com.ar/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "anime-list-alca.vercel.app"
        }
      ],
      "destination": "https://anirecord.com.ar/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "anime-list-matias.vercel.app"
        }
      ],
      "destination": "https://anirecord.com.ar/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "anirecord.vercel.app"
        }
      ],
      "destination": "https://anirecord.com.ar/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://anilist.co; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https://graphql.anilist.co; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://www.dailymotion.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Origin-Agent-Cluster", "value": "?1" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" }
      ]
    },
    {
      "source": "/api/media-preview",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/person-preview",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/(og-image|og-person-image|pwa-icon|pwa-manifest)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/pwa-theme-bootstrap.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(sw.js|manifest.webmanifest|index.html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/media/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|discordbot|Twitterbot|facebookexternalhit|Facebot|WhatsApp|TelegramBot|Slackbot|LinkedInBot).*"
        }
      ],
      "destination": "/api/media-preview?id=:id"
    },
    {
      "source": "/personajes/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|discordbot|Twitterbot|facebookexternalhit|Facebot|WhatsApp|TelegramBot|Slackbot|LinkedInBot).*"
        }
      ],
      "destination": "/api/person-preview?id=:id&kind=character"
    },
    {
      "source": "/seiyuus/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|discordbot|Twitterbot|facebookexternalhit|Facebot|WhatsApp|TelegramBot|Slackbot|LinkedInBot).*"
        }
      ],
      "destination": "/api/person-preview?id=:id&kind=staff"
    },
    {
      "source": "/profesionales/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|discordbot|Twitterbot|facebookexternalhit|Facebot|WhatsApp|TelegramBot|Slackbot|LinkedInBot).*"
        }
      ],
      "destination": "/api/person-preview?id=:id&kind=professional"
    },
    {
      "source": "/api/:path*",
      "destination": "https://p01--anime-list--244mm2wyvsvc.code.run/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
